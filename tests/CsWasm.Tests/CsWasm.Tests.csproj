<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CsWasm.Tests</RootNamespace>
    <AssemblyName>CsWasm.Tests</AssemblyName>
    <!-- xunit's generated entry point trips the AOT analyzer; the compiler under test
         is what has to stay AOT-clean, not the test host. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Common/CsWasm.Common.csproj" />
    <ProjectReference Include="../../src/Backend.MoonBit/CsWasm.Backend.MoonBit.csproj" />
    <ProjectReference Include="../../src/Frontend.Cil/CsWasm.Frontend.Cil.csproj" />
    <ProjectReference Include="../../src/Driver/CsWasm.Driver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample assemblies are input data for the frontend, not code the tests call.
         ReferenceOutputAssembly=false keeps them off the test assembly's reference list,
         so a test can assert that reading a DLL never loads it into this runtime;
         OutputItemType=Content still builds them and copies the DLL next to the tests. -->
    <ProjectReference Include="../Samples/CsWasm.Samples.Poc/CsWasm.Samples.Poc.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Samples/CsWasm.Samples.Unsupported/CsWasm.Samples.Unsupported.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Samples/CsWasm.Samples.BackendUnsupported/CsWasm.Samples.BackendUnsupported.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Samples/CsWasm.Samples.NamingStability/CsWasm.Samples.NamingStability.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
